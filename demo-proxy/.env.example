# Read by the `docker compose` CLI for ${VARIABLE} substitution inside
# docker-compose.yml. NOT injected into any container — that's the env/
# files' job.
#
# Copy to `.env` in this directory and adjust for your machine:
#   cp .env.example .env

# Host path to Caddy's local CA storage, so this containerized Caddy reuses
# the same locally-trusted CA as ignis's and buem-gateway's own reverse
# proxies, instead of generating a new (untrusted) one. Run `caddy trust` on
# the host first (requires Caddy installed locally) if you haven't already
# for those — typically:
#   Linux:   ~/.local/share/caddy
#   macOS:   ~/Library/Application Support/Caddy
CADDY_DATA_DIR=/home/jayravani/.local/share/caddy

# The host port this proxy publishes. Defaults to 8444 — ignis uses 443,
# buem-gateway uses 8443, so this doesn't collide if all three run at once.
HOST_HTTPS_PORT=8444

# weather-serve's own published host port (see
# BuEM/weather/infrastructure/container/docker-compose.serve.yml's
# WEATHER_API_PORT, default 8090). This proxy reaches it via
# host.docker.internal since weather-serve runs in its own compose project,
# not joined to this one.
WEATHER_UPSTREAM_PORT=8090
