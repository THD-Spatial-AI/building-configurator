# Injected into weather-demo-proxy via env_file. Dev-only defaults —
# replace before any real deployment (this proxy is demo-only regardless,
# see docker-compose.yml). Intentionally tracked, same as ignis's and
# buem-gateway's own common.env, so a fresh clone runs out of the box.

# CORS — origins allowed to call this API from a browser. Comma-separated,
# no trailing slash. weather-demo-proxy derives a regex from this at
# startup for its preflight matcher (see docker-compose.yml + Caddyfile).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000
