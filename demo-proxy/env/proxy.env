# Read by weather-demo-proxy's Caddyfile to gate requests behind the
# X-Api-Key header. Must match weather-serve's own WEATHER_API_KEYS
# (BuEM/weather/.env) exactly — this proxy has no auth of its own, it only
# forwards the same credential weather-serve itself checks.
WEATHER_API_KEY=demo-key

# Site address Caddy serves. Keep `localhost` for local development.
WEATHER_SITE_ADDRESS=localhost
