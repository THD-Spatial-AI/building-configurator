# HTTP/3 is disabled: the compose file publishes the HTTPS port as TCP only,
# so an advertised Alt-Svc: h3 leads clients to retry over QUIC and get no
# response. Matches ignis and buem-gateway.
{
	servers {
		protocols h1 h2
	}
}

{$WEATHER_SITE_ADDRESS:localhost} {
	# ALLOWED_ORIGINS_PATTERN is derived from ALLOWED_ORIGINS (env/common.env)
	# by the entrypoint in docker-compose.yml.
	@allowed_origin header_regexp Origin {$ALLOWED_ORIGINS_PATTERN}

	@preflight method OPTIONS

	# Same key and header name as weather-serve's own X-API-Key check, so
	# anything passing this gate also passes upstream. Forwarded unchanged.
	@authorized header X-Api-Key {$WEATHER_API_KEY}

	route {
		# Preflight is answered here, never forwarded upstream.
		handle @preflight {
			header @allowed_origin Access-Control-Allow-Origin "{http.regexp.allowed_origin.1}"
			header Access-Control-Allow-Methods "GET, OPTIONS"
			header Access-Control-Allow-Headers "Content-Type, X-Api-Key"
			header Access-Control-Max-Age "86400"
			respond 204
		}

		handle /v1/weather/health {
			reverse_proxy host.docker.internal:{$WEATHER_UPSTREAM_PORT:8090}
		}

		# weather-serve has no CORS handling of its own, so the origin header
		# is added here on real responses as well as on preflight.
		handle @authorized {
			header @allowed_origin Access-Control-Allow-Origin "{http.regexp.allowed_origin.1}"
			reverse_proxy host.docker.internal:{$WEATHER_UPSTREAM_PORT:8090}
		}

		# CORS header is set on the rejection too, otherwise a bad API key
		# surfaces in the browser as an opaque CORS error rather than a 403.
		handle {
			header @allowed_origin Access-Control-Allow-Origin "{http.regexp.allowed_origin.1}"
			respond "Forbidden: missing or invalid API key" 403
		}
	}
}