{
  "name": "@thd-spatial-ai/building-configurator",
  "version": "0.15.0",
  "description": "Building energy model configurator for the EnerPlanET platform",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THD-Spatial-AI/building-configurator.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && cp src/styles/package.css dist/styles.css",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "capture-fixtures": "node scripts/capture-fixtures.mjs",
    "schema:sync": "node scripts/buem-schema.mjs",
    "schema:check": "node scripts/buem-schema.mjs --check",
    "prepare": "npm run build:lib",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "three": ">=0.186.0 <1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "4.7.0",
    "ajv": "8.18.0",
    "ol": "^10.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.1.12",
    "three": "^0.186.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
